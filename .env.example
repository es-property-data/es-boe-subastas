# Credenciales de usuario registrado del Portal de Subastas del BOE.
# Solo son necesarias con --auth (importe de las pujas de subastas en curso).
# El login pide ademas un codigo de verificacion que el portal envia por
# correo; el recolector lo solicita por la terminal durante el proceso.
BOE_SUBASTAS_EMAIL=
BOE_SUBASTAS_PASSWORD=

# Ruta del fichero donde persistir las cookies de sesion entre ejecuciones.
# Por defecto: ~/.config/boe-subastas/session.json (Linux/macOS)
# o %APPDATA%\boe-subastas\session.json (Windows)
#BOE_SUBASTAS_SESSION_FILE=

# Pon 0 para ver el navegador de Selenium durante el inicio de sesion.
#BOE_SUBASTAS_HEADLESS=1
